#!/bin/bash

[ "${0}" = "${BASH_SOURCE[0]}" ] && {
    echo "Must source this file to be effective" >&2
    exit 1
}

if [[ "${1}" =~ "clear" ]]; then
    PYTHONPATH=
fi

SCRIPTDIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# Add any specific requirements here.
if [ -f "${SCRIPTDIR}/env_extra" ]; then
    # shellcheck source=/dev/null
    source "${SCRIPTDIR}/env_extra" "${@}"
fi

function add_python_path()
{
    if [ -d "${1}" ]; then
        if [ -z "${PYTHONPATH}" ]; then
            export PYTHONPATH="${1}"
        fi
        [[ ${PYTHONPATH} =~ ${1} ]] || export PYTHONPATH=${PYTHONPATH}:${1}
    fi
}

function add_execution_path()
{
    if [ -d "${1}" ]; then
        [[ ${PATH} =~ ${1} ]] || PATH=${PATH}:${1}
    fi
}

# Add some standard locations, if they exist.
add_python_path "${SCRIPTDIR}/lib"
add_python_path "${SCRIPTDIR}/src"
add_execution_path "${SCRIPTDIR}/bin"

# Add any specific requirements here.
echo "Environment setup complete."
